# Browser profiles created by the verification tools on Windows. These contain cookies,
# extension state and Edge Shopping/Wallet data -- never publish them.
.chrome-*/
chrome-err.log

# Node
node_modules/

# Verification output: keep the small machine-readable reports, drop the multi-MB
# Lighthouse HTML/JSON bundles. runs/ is regenerated by the tools themselves.
runs/*.html
runs/lh*
runs/lighthouse*.json
runs/shot-*.png

# Exception: the three revision-4 Lighthouse report JSONs are the acceptance evidence
# for the "3 consecutive fresh-profile runs" criterion and must stay in the repo.
!runs/lh_rev4_1.report.json
!runs/lh_rev4_2.report.json
!runs/lh_rev4_3.report.json

# Loopback server log (tools/serve.mjs appends one line per request)
serve.log
